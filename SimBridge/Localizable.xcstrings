    },
    "Grant Access": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff erlauben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceder acceso"
          }
        }
      }
    },
    "Grant SimBridge one-time access to the CoreSimulator folder to find your simulators and apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube SimBridge einmalig den Zugriff auf den CoreSimulator-Ordner, um deine Simulatoren und Apps zu finden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concede a SimBridge acceso único a la carpeta CoreSimulator para encontrar tus simuladores y apps."
          }
        }
      }
    },
    "Grant Simulator Access…": {
      "localizations": {
        "de": {
