    "Click the “Devices” folder below once, then click “Grant Access”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke unten einmal auf den Ordner „Devices“ und dann auf „Zugriff erlauben“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic una vez en la carpeta «Devices» de abajo y luego en «Conceder acceso»."
          }
        }
      }
    },
    "Couldn’t load mounts: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mounts konnten nicht geladen werden: %@"
