<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- File Provider extensions must be sandboxed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Same shared container as the app (used for signalling; the root path
	     itself is encoded in the domain identifier). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.de.andreasmaser.SimBridge</string>
	</array>

	<!-- Temporary-exception: allow the sandboxed extension to read/write the
	     Simulator container tree directly. Permitted for Developer-ID builds
	     (NOT accepted on the Mac App Store). Path is relative to the user home. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Developer/CoreSimulator/</string>
	</array>
</dict>
</plist>
